{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "AR Media desktop app",
  "author": "AR Media <armedia.arcodes@gmail.com>",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "start:prod": "npm run build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.armedia.app",
    "productName": "AR Media",
    "copyright": "Copyright © 2026 AR Media",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "protocols": [
      {
        "name": "AR Media",
        "schemes": [
          "armedia"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "protocols": [
        {
          "name": "AR Media",
          "schemes": [
            "armedia"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AR Media"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking",
      "protocols": [
        {
          "name": "AR Media",
          "schemes": [
            "armedia"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "protocols": [
        {
          "name": "AR Media",
          "schemes": [
            "armedia"
          ]
        }
      ]
    }
  }
}
